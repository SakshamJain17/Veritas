# Frontend reads this value (defaults to http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Prototype runs only against the simulated demo network. These are examples
# for future EVM integration and are not consumed by the current application.
EVM_NETWORK=demo
# EVM_RPC_URL=
# CONTRACT_DOCUMENT_REGISTRY=
# CONTRACT_CLAIM_REGISTRY=
# CONTRACT_ISSUER_REGISTRY=
# CONTRACT_VERIFICATION_REGISTRY=

# Optional live public-source checks. Set this in the backend process environment.
# Keep the key server-side; never use a NEXT_PUBLIC_ prefix.
TINYFISH_API_KEY=
